# Browser: only the public Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server only. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# Explicit account allowlist; either domains or individual addresses is required.
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=
GEMINI_API_KEY=
# Verify availability in your Google project before enabling analysis.
GEMINI_MODEL=gemini-3.8-flash
AI_REQUESTS_PER_USER_DAY=30
AI_REQUESTS_GLOBAL_DAY=300
