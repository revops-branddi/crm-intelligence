# Browser: only the public Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server only. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# Explicit account allowlist; either domains or individual addresses is required.
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=
LLM_PROVIDER=superproxy
SUPERPROXY_API_KEY=
SUPERPROXY_MODEL=claude-sonnet-5-5
# Optional explicit rollback only: set LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_REQUESTS_PER_USER_DAY=30
AI_REQUESTS_GLOBAL_DAY=300

# Read-only operational sources. Dedicated credentials accepted only by GET readers.
OPERATIONS_COMPANY_ID=
SERP_MONITOR_READ_KEY=
REPORT_ENGINE_READ_KEY=
